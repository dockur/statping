{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":disableDependencyDashboard"
  ],
  "forkProcessing": "disabled",
  "npm": {
    "enabled": false
  },
  "gomod": {
    "enabled": false
  },
  "dockerfile": {
    "enabled": false
  },
   "docker-compose": {
    "enabled": false
  },
  "packageRules": [
    {
      "description": "Do not update GitHub Actions in build.yml",
      "matchManagers": [
        "github-actions"
      ],
      "matchFileNames": [
        ".github/workflows/build.yml"
      ],
      "enabled": false
    },
    {
      "description": "Do not update the Go module version",
      "matchDatasources": [
        "golang-version"
      ],
      "enabled": false
    },
    {
      "description": "Do not update the Go Docker image",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "golang"
      ],
      "enabled": false
    }
  ]
}
